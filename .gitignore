# Build output
/sshplace

# Runtime state: host key, canvas snapshot, event log. The host key in
# particular must never be committed.
/data/

# Test and profiling output
*.test
*.out
coverage.*

# Per-server settings, including the exempt key fingerprints. Deliberately not
# committed: the whole point is that it stays on the box.
docker-compose.override.yml

# Timelapse output. Regenerate with: go run ./cmd/timelapse
*.gif
